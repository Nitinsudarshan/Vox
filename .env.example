# Vox environment configuration
#
# Copy to `.env` in the repository root. Debug builds read it at startup.
# Every name also works with the pre-rename `RELAY_` prefix, so an existing
# `.env` keeps working; new setups should use `VOX_`.

# Supabase backend (hybrid mode). From Supabase Project Settings > API.
# Only the anon key belongs here — never the service-role key.
VOX_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VOX_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Google OAuth desktop client, for sign-in and Calendar.
# See docs/GOOGLE_OAUTH_SETUP.md. Read at build time or run time.
# VOX_GOOGLE_CLIENT_ID=""
# VOX_GOOGLE_CLIENT_SECRET=""

# Optional: where Vox keeps its vault and config, overriding the default
# (%APPDATA%\com.vox.app on Windows for a fresh install).
# VOX_HOME=""
